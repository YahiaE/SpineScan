FROM redis:7-alpine

CMD ["sh", "-c", ": \"${FLY_PRIVATE_IP:?FLY_PRIVATE_IP is required}\"; : \"${REDIS_PASSWORD:?REDIS_PASSWORD is required}\"; exec redis-server --bind \"$FLY_PRIVATE_IP\" --port 6379 --requirepass \"$REDIS_PASSWORD\" --maxmemory 256mb --maxmemory-policy noeviction --save \"\" --appendonly no"]
